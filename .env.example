# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# MongoDB Atlas Connection
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?appName=jehosueai
MONGODB_DB_NAME=jehosue_ai

# Python Backend Server URL (Optional, default is http://127.0.0.1:5000)
PYTHON_BACKEND_URL=http://127.0.0.1:5000
PORT=5000
