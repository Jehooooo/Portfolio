# ─────────────────────────────────────────────────────────
# Portfolio Environment Variables
# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local or any real credentials to Git!
# ─────────────────────────────────────────────────────────

# Google Gemini AI API Key
GEMINI_API_KEY=your_gemini_api_key_here

# MongoDB Atlas Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?appName=jehosueai

# MongoDB Database Name (optional, default: jehosue_ai)
MONGODB_DB_NAME=jehosue_ai

# Python Flask Backend Port (optional, default: 5000)
PORT=5000

# Admin Secret for Row-Level Security access (generate a strong random string!)
ADMIN_SECRET=replace_with_a_strong_random_secret_here

# Enable Row-Level Security (true/false)
ENABLE_RLS=true

# Python Backend URL used by Next.js (optional, for deployment)
PYTHON_BACKEND_URL=http://127.0.0.1:5000